# ==============================================================================
# Blood Donor Management System - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. Copy this template to `.env` in the project root AND/OR `server/.env`.
# 2. NEVER commit real credentials or .env files to Git / version control.
# 3. .env is excluded by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_TITLE="Blood Donor Management System"

# ------------------------------------------------------------------------------
# 2. Express Backend Server
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection URL (Prisma)
# ------------------------------------------------------------------------------
# Choose one of the following formats based on your setup:
#
# Option A: Local PostgreSQL (installed via Windows installer, winget, or Docker)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/blood_donor_db?schema=public"
#
# Option B: Managed Serverless PostgreSQL (Neon - Recommended free provider)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
#
# Option C: Supabase PostgreSQL (Managed provider)
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
#
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/blood_donor_db?schema=public"

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT Secrets)
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_random_64_character_secret_in_production"
JWT_EXPIRES_IN="7d"
