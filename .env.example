# Blood Donor Management System - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or .env files into version control!

# ==========================================
# Client Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=/api
VITE_APP_TITLE="Blood Donor Management System"

# ==========================================
# Server Configuration (Express & Node.js)
# ==========================================
PORT=5000
NODE_ENV=development
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# ==========================================
# Database Configuration (PostgreSQL & Prisma)
# ==========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_donor_db?schema=public"

# ==========================================
# Security & Authentication (JWT Secrets)
# ==========================================
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_EXPIRES_IN="7d"
